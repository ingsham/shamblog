# Postgres connection string (Neon, Vercel Postgres, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# Admin login (single admin account, no separate signup flow)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Random long string used to sign admin session tokens
JWT_SECRET=replace-with-a-long-random-string

# Created automatically when you enable Vercel Blob storage on your project
BLOB_READ_WRITE_TOKEN=

# Branding
NEXT_PUBLIC_SITE_NAME=SHAM
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
