# --- Required ---------------------------------------------------------------
# Postgres connection string. On Vercel, adding a Neon/Supabase/Postgres
# database from the Storage tab sets this for you automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for the /admin login page. CHANGE THIS.
ADMIN_PASSWORD=change-me-before-you-deploy

# Random string used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
ADMIN_SECRET=paste-a-long-random-string-here

# --- Optional ---------------------------------------------------------------
# Your live URL. Vercel fills this in on its own, so only set it if you
# attach a custom domain and want correct links in RSS / share buttons.
# NEXT_PUBLIC_SITE_URL=https://sham.vercel.app
